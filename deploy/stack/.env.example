# Names only, for humans: no tool reads this file. Values are placed on the host
# by the owner's provisioning (tools/stack env-set), never committed.
TS_AUTHKEY=
# The bellwether Pocket ID client: redirect https://bellwether.<tailnet>/oauth2/callback,
# logout callback https://bellwether.<tailnet>/. Its allowed groups gate the door.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# The id node's tailscale IP (tailscale ip -4 id): the OIDC backchannel.
ID_TAILNET_IP=
# The atp role's password, fixed when the database was initialised.
POSTGRES_PASSWORD=
# OAUTH2_PROXY_COOKIE_SECRET is generated on the host
