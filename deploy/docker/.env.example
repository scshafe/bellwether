# SUPERSEDED — reference only; the live stack is infra's stacks/bellwether.
# Copy to .env (gitignored) and fill in. PAPER MONEY ONLY.
# Strong secrets; .env is never committed.
POSTGRES_PASSWORD=replace-with-strong-password

# --- Identity ---------------------------------------------------------
# There is no portal password. A human signs in at Pocket ID, an OIDC proxy
# forwards the id token, and the server verifies its signature. This file
# configures only the app's half; the door itself lives in the infra stack.
POCKETID_ISSUER=https://id.colobus-stargazer.ts.net
POCKETID_CLIENT_ID=replace-with-pocket-id-client-id

# Nothing about people is configured here: roles live in the portal_users
# table. The first sign-in on an empty portal becomes its admin.

# Host dir holding the canonical PAPER credential files (read-only bind mounts):
#   alpaca-paper.env, openai-oauth.json
BELLWETHER_AGENT_RESOURCES=/Users/cole/.mission-control/agent-resources/bellwether
