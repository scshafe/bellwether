POSTGRES_DB=agent_trading_platform
POSTGRES_USER=atp
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgres://atp:replace-me@db:5432/agent_trading_platform
HOST=0.0.0.0
PORT=3000
PUBLIC_BASE_URL=http://127.0.0.1:3000
HEALTHCHECK_URL=http://127.0.0.1:3000/healthz
AGENT_RUNTIME_NAME=docker-compose
DATABASE_SERVICE_NAME=db
WORKER_SERVICE_NAME=worker
WORKER_POLL_INTERVAL_MS=5000
WORKER_READY_FILE=/tmp/worker-ready
COMPOSE_PROJECT_NAME=agent-trading-platform
POSTGRES_VOLUME_NAME=postgres-data
# Identity. Pocket ID is the only human credential; the portal has no login of
# its own. oauth2-proxy terminates OIDC in front of the app and forwards the
# id token, which the server verifies against the issuer's JWKS.
PORTAL_OIDC_ISSUER=https://id.example.ts.net
PORTAL_OIDC_AUDIENCE=bellwether-portal
# Optional: pin the key set (skips discovery) or read the token from another
# header (default: Authorization: Bearer).
# PORTAL_OIDC_JWKS_URL=https://id.example.ts.net/.well-known/jwks.json
# PORTAL_OIDC_TOKEN_HEADER=authorization
# Authorization is the app's job and lives in the database: portal_users maps
# a Pocket ID subject to a role. Nothing about a person is configured here —
# the first person to sign in on an empty portal becomes its admin, and grants
# every account after that from the portal's Access screen.
# Optional future live-broker scaffold. The current deployment must not mount this file.
# BELLWETHER_FEATURE_BROKER_MODE_LIVE=0
# ALPACA_LIVE_CREDENTIAL_FILE=/srv/bellwether/alpaca-live.env
