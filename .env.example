POSTGRES_DB=agent_trading_platform
POSTGRES_USER=atp
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgres://atp:replace-me@db:5432/agent_trading_platform
HOST=0.0.0.0
PORT=3000
PUBLIC_BASE_URL=http://127.0.0.1:3000
HEALTHCHECK_URL=http://127.0.0.1:3000/healthz
AGENT_RUNTIME_NAME=docker-compose
DATABASE_SERVICE_NAME=db
WORKER_SERVICE_NAME=worker
WORKER_POLL_INTERVAL_MS=5000
WORKER_READY_FILE=/tmp/worker-ready
COMPOSE_PROJECT_NAME=agent-trading-platform
POSTGRES_VOLUME_NAME=postgres-data
PORTAL_ADMIN_ID=portal-admin
PORTAL_ADMIN_USERNAME=admin
PORTAL_ADMIN_PASSWORD=change-me
PORTAL_ADMIN_DISPLAY_NAME=Administrator
PORTAL_ADMIN_ROLE=admin
# Optional additional portal users. Uncomment and set passwords to provision them.
# PORTAL_MANAGER_ID=portal-manager
# PORTAL_MANAGER_USERNAME=manager
# PORTAL_MANAGER_PASSWORD=change-me
# PORTAL_MANAGER_DISPLAY_NAME=Manager
# PORTAL_MANAGER_ROLE=manager
# PORTAL_VIEWER_ID=portal-viewer
# PORTAL_VIEWER_USERNAME=viewer
# PORTAL_VIEWER_PASSWORD=change-me
